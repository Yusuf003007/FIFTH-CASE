          </mxGeometry>
        </mxCell>
        <mxCell id="SZ1HV2CInSs_IdlOZ13Z-15" value="&lt;div&gt;Our main character is a detective, and the game begins with a nightmare he is having. He wakes up to the sound of a phone ringing. The caller is a police inspector at a crime scene, asking for help from his old friend. Our character agrees and heads to the scene.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="260" y="280" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="SZ1HV2CInSs_IdlOZ13Z-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="SZ1HV2CInSs_IdlOZ13Z-18" target="SZ1HV2CInSs_IdlOZ13Z-2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n9fOUolEITiEXT3mDwRn-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="SZ1HV2CInSs_IdlOZ13Z-18" target="SZ1HV2CInSs_IdlOZ13Z-3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="SZ1HV2CInSs_IdlOZ13Z-18" value="After arriving, he first talks to the inspector who called him and gathers the necessary information. Then control is given to the player, who starts investigating the surroundings. We find a few small clues and then collect information from other teams at the scene (such as forensics)." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="490" y="405" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="SZ1HV2CInSs_IdlOZ13Z-22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="SZ1HV2CInSs_IdlOZ13Z-21" target="SZ1HV2CInSs_IdlOZ13Z-8" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="SZ1HV2CInSs_IdlOZ13Z-21" value="Next, we talk to the person who found the body. This person should appear nervous, as if hiding something, creating a small sense of suspicion so the player begins to suspect other characters as well." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="765" y="305" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="SZ1HV2CInSs_IdlOZ13Z-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="SZ1HV2CInSs_IdlOZ13Z-23" target="SZ1HV2CInSs_IdlOZ13Z-10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="SZ1HV2CInSs_IdlOZ13Z-23" value="Afterwards, we go to a quiet place to evaluate the clues. While the main character is smoking (in this scene, the camera slightly zooms in and calm music plays), we see another detective. However, this figure is imaginary and can only be seen by our character." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="900" y="425" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="SZ1HV2CInSs_IdlOZ13Z-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="SZ1HV2CInSs_IdlOZ13Z-25" target="SZ1HV2CInSs_IdlOZ13Z-12" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="SZ1HV2CInSs_IdlOZ13Z-25" value="A short conversation takes place between them, filled with sharp and witty dialogue. The player reviews the collected clues and notices something important related to a clue, but cannot fully understand or connect the pieces. Then, the first chapter ends." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1060" y="295" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="SZ1HV2CInSs_IdlOZ13Z-28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="SZ1HV2CInSs_IdlOZ13Z-27" target="SZ1HV2CInSs_IdlOZ13Z-15" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="SZ1HV2CInSs_IdlOZ13Z-27" value="&lt;div&gt;NIGHTMARE:&lt;/div&gt;&lt;div&gt;The main character is chasing someone. The person’s face is not visible, and they are holding a gun. The environment is dark. Our character shouts “Stop! Surrender!” from behind, and the scene cuts. Then we wake up.&quot;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="260" y="580" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n9fOUolEITiEXT3mDwRn-2" value="3 policeman&lt;div&gt;1 withness&lt;/div&gt;&lt;div&gt;2 inspector&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="630" y="570" width="110" height="50" as="geometry" />
        </mxCell>
        <mxCell id="N_7YIYTTOeZvxc78QOW0-1" value="Go talk to the inspector" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="630" y="680" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="N_7YIYTTOeZvxc78QOW0-2" value="Collect items and policeman" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="780" y="680" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="N_7YIYTTOeZvxc78QOW0-3" value="talk to the withness" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="930" y="680" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o0jyTHsvqFrJEs3EQRNe-1" value="&lt;div&gt;- anymous character from nightmare&lt;/div&gt;- player&lt;div&gt;- phone&lt;/div&gt;&lt;div&gt;- police inspector&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="210" width="100" height="115" as="geometry" />
        </mxCell>
